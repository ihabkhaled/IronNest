{
  "name": "iron-nest",
  "version": "1.0.0",
  "description": "Iron discipline for NestJS backends — clean architecture enforced by custom ESLint rules, strict TypeScript, SDLC governance, an AI-agent knowledge base (rules, skills, memory, context), and a runnable Fastify + Pino reference app.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0"
  },
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "$fastify"
    },
    "brace-expansion": "5.0.8",
    "fast-uri": "3.1.4",
    "find-my-way": "9.7.0",
    "postcss": "8.5.23",
    "@fastify/static": "10.1.2",
    "@nestjs/swagger": {
      "js-yaml": "5.2.2"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "compiler:version": "node node_modules/@typescript/native/bin/tsc --version",
    "compiler:check": "node tools/compiler/check-native-typescript.mjs",
    "build": "npm run compiler:check && node node_modules/@typescript/native/bin/tsc -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --concurrency 2 --max-warnings 0 --report-unused-disable-directives",
    "lint:fix": "eslint . --concurrency 2 --max-warnings 0 --report-unused-disable-directives --fix",
    "typecheck": "npm run compiler:check && node node_modules/@typescript/native/bin/tsc --pretty --noEmit --incremental false",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/app.e2e-spec.ts",
    "test:e2e": "vitest run test/app.e2e-spec.ts",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk run --pool=forks --poolOptions.forks.singleFork=true",
    "test:coverage": "vitest run --coverage",
    "gate:lint": "npm run format:check && npm run lint",
    "gate:typecheck": "npm run typecheck",
    "gate:unit": "npm run test:unit",
    "gate:e2e": "npm run test:e2e",
    "gate:coverage": "npm run test:coverage",
    "gate:build": "npm run build",
    "gate:knowledge": "npm run knowledge:check && npm run knowledge:verify && npm run knowledge:benchmark",
    "gate:security": "npm run security:audit && npm run security:scan",
    "gate:commit": "npm run lint-staged && npm run gate:typecheck",
    "gate:push": "npm run gate:coverage && npm run gate:build && npm run gate:knowledge",
    "validate": "npm run gate:lint && npm run gate:typecheck && npm run gate:unit && npm run gate:e2e && npm run gate:coverage && npm run gate:build && npm run gate:knowledge",
    "validate:release": "npm run validate && npm run gate:security",
    "knowledge:build": "node tools/knowledge/build-manifests.mjs && node tools/knowledge/build-summaries.mjs",
    "knowledge:check": "node tools/knowledge/build-hashes.mjs --check",
    "knowledge:context": "node tools/knowledge/resolve-context.mjs",
    "knowledge:benchmark": "node tools/knowledge/benchmark.mjs",
    "knowledge:verify": "node tools/knowledge/verify.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:scan": "trivy fs --scanners vuln,secret,misconfig --include-dev-deps --skip-dirs node_modules,dist,coverage --exit-code 1 --severity HIGH,CRITICAL .",
    "security:scan:full": "trivy fs --scanners vuln,secret,misconfig --include-dev-deps --skip-dirs node_modules,dist,coverage .",
    "deps:check": "npm-check-updates",
    "deps:upgrade": "npm-check-updates -u && npm install",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "postinstall": "node tools/security/patch-brace-expansion-compat.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.1",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-check-updates": "^23.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@swc/core@1.15.43": true,
    "bcrypt@6.0.0": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false
  }
}
